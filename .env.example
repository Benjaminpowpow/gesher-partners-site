# Copy this file to .env for local runs. Never commit .env, it is gitignored.
# On Render these same names go in Dashboard -> Environment.
#
# The site loads and every page renders with none of these set. They only turn
# on the parts that talk to the outside world.

# --- Email. Without it the contact form returns an error instead of a
# thank-you, on purpose. A form that says "thanks" and sends nothing loses
# leads. resend.com, free up to 3,000 emails a month.
RESEND_API_KEY=

# Where new leads get emailed. Falls back to MAIL_FROM.
LEAD_NOTIFICATION_EMAIL=

# The address email is sent FROM. Must sit on a domain verified in Resend.
# Defaults to office@gesherpartners.com. Leave blank unless that changes.
MAIL_FROM=

# --- The temporary lead list. Every contact-form submission also writes a row
# to a Google Sheet through an Apps Script web app. Paste the deployed URL, the
# long one ending in /exec. Treat it as a secret. Blank means no list is kept.
# Script and setup steps: references/leads-sheet.gs in this repo.
LEADS_SHEET_WEBHOOK=

# --- Exit Brief. Without it /exit-brief returns an error.
# console.anthropic.com
ANTHROPIC_API_KEY=

# How many free Briefs the whole site runs in one day, Israel time. Blank means
# 10. This is the soft cap. The hard one is the monthly spend limit on the key
# itself in the Anthropic console. One visitor can only take 3 of the day's
# Briefs, and cannot start two inside a minute.
EXIT_BRIEF_DAILY_CAP=

# Which model writes the Brief. Blank means claude-haiku-4-5, the cheapest one.
# Set claude-sonnet-5 here if the Briefs read thin. About 11 cents more each,
# and it takes effect on the next run, no deploy.
EXIT_BRIEF_MODEL=

# --- Optional. Slack ping when a lead comes in.
SLACK_WEBHOOK_URL=

# --- Optional. Stores valuation leads. The site runs fine without it, it just
# does not keep a record. Needed once we build the buyer/seller portal.
DATABASE_URL=

# --- Manus leftovers. Not needed. Login is not used on the public site.
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# JWT_SECRET=
# VITE_APP_ID=
